{
  "manifest_version": 3,
  "name": "Traqula Bridge",
  "version": "0.5.0",
  "description": "Tells the Traqula app who is speaking, whether you are muted, and who is in your browser meetings. Talks only to Traqula on this Mac.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "bridge.js",
        "meet.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zoom.us/wc/*",
        "https://app.zoom.us/wc/*"
      ],
      "js": [
        "bridge.js",
        "zoomweb.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "bridge.js",
        "teams.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "alarms"
  ]
}
